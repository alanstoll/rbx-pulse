{
  "uid": "pulse-player-state",
  "title": "Pulse / Player state",
  "tags": [
    "pulse"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "",
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Database",
        "type": "datasource",
        "query": "grafana-postgresql-datasource",
        "current": {
          "selected": false,
          "text": "pulse",
          "value": "pulse-postgres"
        },
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "description": "pulse = your game (DATABASE_URL); pulse-demo = the turn-key demo"
      },
      {
        "name": "stat",
        "label": "Numeric fact",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${ds}"
        },
        "query": "SELECT DISTINCT key FROM fact WHERE kind IN ('counter','gauge') AND dim = '' ORDER BY 1",
        "definition": "SELECT DISTINCT key FROM fact WHERE kind IN ('counter','gauge') AND dim = '' ORDER BY 1",
        "refresh": 1,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "keyed",
        "label": "Keyed fact",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${ds}"
        },
        "query": "SELECT DISTINCT key FROM fact WHERE dim <> '' ORDER BY 1",
        "definition": "SELECT DISTINCT key FROM fact WHERE dim <> '' ORDER BY 1",
        "refresh": 1,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "label",
        "label": "Label fact",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${ds}"
        },
        "query": "SELECT DISTINCT key FROM fact WHERE kind = 'label' ORDER BY 1",
        "definition": "SELECT DISTINCT key FROM fact WHERE kind = 'label' ORDER BY 1",
        "refresh": 1,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Players with a profile",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*) AS players FROM profile_version WHERE valid_to IS NULL"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Profile versions",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*) AS versions FROM profile_version"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Facts (current)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*) AS facts FROM v_fact_current"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Events harvested",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*) AS events FROM event"
        }
      ]
    },
    {
      "id": 5,
      "type": "histogram",
      "title": "Distribution of $stat (current)",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "options": {
        "bucketCount": 30
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT num AS \"$stat\" FROM v_fact_current WHERE key = '$stat' AND dim = ''"
        }
      ]
    },
    {
      "id": 6,
      "type": "barchart",
      "title": "Boolean facts: share of players true",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "always"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT key, round(100.0 * avg(bool::int), 1) AS pct FROM v_fact_current WHERE kind = 'boolean' AND dim = '' GROUP BY key ORDER BY pct DESC"
        }
      ]
    },
    {
      "id": 7,
      "type": "barchart",
      "title": "$keyed: players per key (top 30)",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "always"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT dim, count(*) AS players FROM v_fact_current WHERE key = '$keyed' AND (bool IS DISTINCT FROM false) GROUP BY dim ORDER BY players DESC LIMIT 30"
        }
      ]
    },
    {
      "id": 8,
      "type": "piechart",
      "title": "$label: distribution",
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT text AS label, count(*) AS players FROM v_fact_current WHERE key = '$label' GROUP BY text ORDER BY players DESC"
        }
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "Current player state (v_player_current)",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT * FROM v_player_current ORDER BY valid_from DESC LIMIT 500"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Harvested events per day by type",
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT date_trunc('day', ts) AS time, type AS metric, count(*) AS value FROM event WHERE $__timeFilter(ts) GROUP BY 1, 2 ORDER BY 1"
        }
      ]
    }
  ]
}
