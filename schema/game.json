{
  "$id": "https://github.com/knightav/rbx-pulse/schema/game.json",
  "title": "rbx-pulse game.yaml",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "universeId": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "string",
          "pattern": "^\\d+$"
        }
      ]
    },
    "apiKeyEnv": {
      "default": "ROBLOX_API_KEY",
      "type": "string",
      "minLength": 1
    },
    "baseUrl": {
      "default": "https://apis.roblox.com",
      "type": "string",
      "pattern": "^https?:\\/\\/"
    },
    "datastores": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "default": "global",
            "type": "string",
            "minLength": 1
          },
          "keyTemplate": {
            "type": "string",
            "pattern": "\\{userId\\}"
          },
          "envelope": {
            "default": "raw",
            "type": "string",
            "enum": [
              "raw",
              "documentservice"
            ]
          },
          "mount": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,62}(\\.[a-z][a-z0-9_]{0,62})*$"
          },
          "alias": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,62}$"
          },
          "sync": {
            "default": {},
            "type": "object",
            "properties": {
              "discovery": {
                "type": "string",
                "enum": [
                  "list",
                  "index"
                ]
              },
              "backfill": {
                "default": true,
                "type": "boolean"
              }
            }
          }
        },
        "required": [
          "name",
          "keyTemplate"
        ]
      }
    },
    "sync": {
      "default": {},
      "type": "object",
      "properties": {
        "index": {
          "type": "object",
          "properties": {
            "orderedDatastore": {
              "type": "string",
              "minLength": 1
            },
            "scope": {
              "default": "global",
              "type": "string",
              "minLength": 1
            },
            "keyTemplate": {
              "default": "{userId}",
              "type": "string",
              "pattern": "\\{userId\\}"
            },
            "valueUnit": {
              "default": "seconds",
              "type": "string",
              "enum": [
                "seconds",
                "millis"
              ]
            },
            "marginMinutes": {
              "default": 120,
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "orderedDatastore"
          ]
        },
        "budgetFraction": {
          "default": 0.25,
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "maxRequestsPerMinute": {
          "default": 120,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "concurrency": {
          "default": 4,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 32
        },
        "includeTestPlayers": {
          "default": false,
          "type": "boolean"
        },
        "window": {
          "type": "object",
          "properties": {
            "start": {
              "type": "string",
              "pattern": "^\\d{2}:\\d{2}$"
            },
            "end": {
              "type": "string",
              "pattern": "^\\d{2}:\\d{2}$"
            },
            "timezone": {
              "default": "UTC",
              "type": "string"
            }
          },
          "required": [
            "start",
            "end"
          ]
        }
      }
    }
  },
  "required": [
    "universeId",
    "datastores"
  ]
}
