# Copy to .env and fill in. .env is gitignored.

# Roblox Open Cloud API key with read access to the universe's DataStores.
# Not needed for the demo (`pulse demo seed`).
ROBLOX_API_KEY=

# Where your private config lives (default ./config, gitignored).
PULSE_CONFIG_DIR=./config

# Host ports for the docker-compose services. Change if 5432/3000 are taken locally.
PULSE_PG_PORT=5432
PULSE_GRAFANA_PORT=3000

# Your game's database (port must match PULSE_PG_PORT).
DATABASE_URL=postgres://pulse:pulse@localhost:5432/pulse

# The demo tenant: a separate database on the same server, created by docker-compose on
# first start (or by `pulse demo seed` if missing). Defaults to DATABASE_URL with the
# database swapped for pulse_demo, so this line is optional.
PULSE_DEMO_DATABASE_URL=postgres://pulse:pulse@localhost:5432/pulse_demo

# Integration tests wipe and reuse this database. `npm test` runs them when this is set.
PULSE_TEST_DATABASE_URL=postgres://pulse:pulse@localhost:5432/pulse_test

# Grafana admin password for the docker-compose Grafana.
GRAFANA_ADMIN_PASSWORD=pulse
