{
  "uid": "pulse-sync-health",
  "title": "Pulse / Sync health",
  "tags": [
    "pulse"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Sync runs",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT id, started_at, finished_at, status, stats FROM sync_run ORDER BY started_at DESC LIMIT 50"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Players seen",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*) AS players FROM player WHERE purged_at IS NULL"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Snapshots stored",
      "gridPos": {
        "x": 8,
        "y": 10,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*) AS snapshots FROM snapshot"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Observations per run (changed vs unchanged)",
      "gridPos": {
        "x": 16,
        "y": 10,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT date_trunc('hour', observed_at) AS time, CASE WHEN changed THEN 'changed' ELSE 'unchanged' END AS metric, count(*) AS value FROM observation WHERE $__timeFilter(observed_at) GROUP BY 1, 2 ORDER BY 1"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Latest run by datastore",
      "description": "One line per datastore and outcome for the most recent sync run. `absent` means a supplemental store had no entry for a player reached through the login index (expected); `missing` means a listed key vanished.",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT o.datastore, o.status, count(*) FILTER (WHERE o.changed) AS changed, count(*) FILTER (WHERE NOT o.changed AND o.status = 'ok') AS unchanged, count(*) AS observations FROM observation o WHERE o.sync_run_id = (SELECT max(id) FROM sync_run) GROUP BY 1, 2 ORDER BY 1, 2"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Database",
        "type": "datasource",
        "query": "grafana-postgresql-datasource",
        "current": {
          "selected": false,
          "text": "pulse",
          "value": "pulse-postgres"
        },
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "description": "pulse = your game (DATABASE_URL); pulse-demo = the turn-key demo"
      }
    ]
  }
}
